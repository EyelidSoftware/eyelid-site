---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services, servicePages } from "../../lib/content";
---

<BaseLayout
  title="Desenvolvimento sob medida e consultoria tecnológica"
  description="Conheça as três formas de trabalhar com nossa equipe: desenvolvimento sob medida, consultoria tecnológica e acompanhamento de processos."
  path="/servicos"
>
  <div class="container">
    <header class="page-heading">
      <p class="eyebrow">O que fazemos</p>
      <h1>Três formas de trabalhar com a gente.</h1>
      <p class="lead">
        Podemos construir um sistema, ajudar sua equipe a escolher um caminho ou acompanhar melhorias em uma operação que já funciona.
      </p>
    </header>
    <div class="service-list">
      {services.map((s) => (
        <a class="service-row" href={`/servicos/${s.slug}`}>
          <span class="num">{s.num}</span>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
    <section class="section">
      <h2>Automação e IA</h2>
      <p class="lead">Aplicamos essas ferramentas nos projetos em que elas resolvem uma tarefa definida.</p>
      <div class="actions">
        {servicePages.slice(3).map((service) => <a href={`/servicos/${service.slug}`}>{service.title} ↗</a>)}
      </div>
    </section>
    <section class="section">
      <div class="contact-band">
        <div>
          <h2>Vamos encontrar o caminho?</h2>
          <p>Uma conversa sobre seu processo é um bom começo.</p>
        </div>
        <a class="btn btn--primary" href="/contato">
          Fale com a gente ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
