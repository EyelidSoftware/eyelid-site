---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { servicePages, articles } from "../../lib/content";
import { productBySlug } from "../../lib/site";
export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const exampleProduct = service.slug === "software-sob-medida" ? productBySlug("autofeedr") : undefined;
const additionalGuide = "additionalGuide" in service ? service.additionalGuide : undefined;
const guides = articles.filter((article) =>
  article.slug === service.guide || article.slug === additionalGuide,
);
---

<BaseLayout
  title={service.title}
  description={service.description}
  path={`/servicos/${service.slug}`}
>
  <div class="container">
    <header class="page-heading">
      <a class="eyebrow" href="/servicos">
        ← Nossos serviços
      </a>
      <h1>{service.title}</h1>
      <p class="lead">{service.description}</p>
      <a href="/contato" class="btn btn--primary">
        Converse sobre seu projeto ↗
      </a>
    </header>
    <section class="section split">
      <div>
        <p class="eyebrow">Onde atuamos</p>
        <h2>Quando faz sentido</h2>
        <ul>
          {service.examples.map((example) => <li>{example}</li>)}
        </ul>
        {exampleProduct && (
          <p>
            Conheça um produto que desenvolvemos, o <a href={`/${exampleProduct.slug}`}>{exampleProduct.name}</a>,
            que reúne publicação de conteúdo e integração com GitHub.
          </p>
        )}
        <h3>Guias para decidir</h3>
        <ul>
          {guides.map((guide) => (
            <li><a class="text-link" href={`/blog/${guide.slug}`}>{guide.title} ↗</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Da conversa à entrega</p>
        <h2>Como trabalhamos</h2>
        <ol class="delivery-steps">
          {service.steps.map(([title, text]) => (
            <li><h3>{title}</h3><p>{text}</p></li>
          ))}
        </ol>
      </div>
    </section>
    {"questions" in service && (
      <section class="section prose">
        <h2>Dúvidas sobre a contratação</h2>
        {service.questions.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
        <a class="btn btn--primary" href="/contato">Converse sobre seu projeto ↗</a>
      </section>
    )}
  </div>
</BaseLayout>
