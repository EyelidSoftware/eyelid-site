---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { servicePages, articles } from "../../lib/content";
export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const guide = articles.find((article) => article.slug === service.guide);
---

<BaseLayout
  title={service.title}
  description={service.description}
  path={`/servicos/${service.slug}`}
>
  <div class="container">
    <header class="page-heading">
      <a class="eyebrow" href="/servicos">
        ← Nossos serviços
      </a>
      <h1>{service.title}</h1>
      <p class="lead">{service.description}</p>
      <a href="/contato" class="btn btn--primary">
        Converse sobre seu projeto ↗
      </a>
    </header>
    <section class="section split">
      <div>
        <p class="eyebrow">Onde atuamos</p>
        <h2>Quando faz sentido</h2>
        <ul>
          {service.examples.map((example) => <li>{example}</li>)}
        </ul>
        {guide && <a class="text-link" href={`/blog/${guide.slug}`}>{guide.title} ↗</a>}
      </div>
      <div>
        <p class="eyebrow">Da conversa à entrega</p>
        <h2>Como trabalhamos</h2>
        <ol class="delivery-steps">
          {service.steps.map(([title, text]) => (
            <li><h3>{title}</h3><p>{text}</p></li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>
