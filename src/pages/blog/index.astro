---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles } from "../../lib/content";
---

<BaseLayout
  title="Guias sobre software, consultoria e processos"
  description="Guias práticos sobre desenvolvimento sob medida, consultoria tecnológica, melhoria de processos, automação e IA."
  path="/blog"
>
  <div class="container">
    <header class="page-heading">
      <p class="eyebrow">Artigos</p>
      <h1>
        Guias de tecnologia para empresas.
      </h1>
      <p class="lead">
        Como avaliar um projeto de software, contratar consultoria e medir melhorias na operação.
      </p>
    </header>
    <section class="section article-grid">
      {articles.map((a) => (
        <a class="article-card" href={`/blog/${a.slug}`}>
          <span class="eyebrow">{a.category}</span>
          <h3>{a.title}</h3>
          <p>{a.excerpt}</p>
          <span class="read">Ler artigo ↗</span>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>
