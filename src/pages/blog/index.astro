---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles } from "../../lib/content";
---

<BaseLayout
  title="Guias sobre software, consultoria e processos"
  description="Guias práticos sobre desenvolvimento sob medida, consultoria tecnológica, melhoria de processos, automação e IA."
  path="/blog"
>
  <div class="container journal">
    <header class="journal-heading">
      <p class="eyebrow">Artigos</p>
      <h1>
        Para decidir
        <br />o próximo passo.
      </h1>
      <p class="lead">
        Guias sobre software, IA e automação para quem quer melhorar a operação
        ou começar uma ideia.
      </p>
    </header>
    <section class="journal-grid" aria-label="Todos os artigos">
      {articles.map((article) => (
        <a class="journal-card" href={`/blog/${article.slug}`}>
          <span class="eyebrow">{article.category}</span>
          <h2>{article.title}</h2>
          <p>{article.excerpt}</p>
          <span class="journal-read">
            Ler artigo <span aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </section>
    <div class="journal-footer">
      <p>Quer aplicar essas ideias na sua empresa?</p>
      <a class="text-link" href="/contato">
        Converse com a equipe ↗
      </a>
    </div>
  </div>
</BaseLayout>
<style>
  .journal {
    padding-bottom: var(--space-20);
  }
  .journal-heading {
    padding-block: var(--space-20) var(--space-16);
    max-width: 820px;
  }
  .journal-heading h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.06;
    margin-block: var(--space-6);
  }
  .journal-heading .lead {
    max-width: 48ch;
    font-size: var(--text-base);
    margin: 0;
  }
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-12) var(--space-8);
  }
  .journal-card {
    display: flex;
    flex-direction: column;
    align-items: start;
    border-top: 1px solid var(--border-strong);
    padding-top: var(--space-6);
    text-decoration: none;
    min-width: 0;
  }
  .journal-card > .eyebrow {
    font-size: 0.65rem;
    min-height: var(--space-5);
  }
  .journal-card h2 {
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.25;
    margin-block: var(--space-4);
  }
  .journal-card > p {
    color: var(--text-2);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .journal-read {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--text-xs);
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--text-2);
  }
  .journal-read > span {
    font-size: var(--text-lg);
  }
  .journal-card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .journal-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    font-size: var(--text-sm);
  }
  .journal-footer p {
    margin: 0;
    color: var(--text-2);
  }
  @media (max-width: 900px) {
    .journal-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .journal-heading {
      padding-block: var(--space-12);
    }
    .journal-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .journal-card h2 {
      font-size: var(--text-xl);
    }
    .journal-footer {
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>
