---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles, servicePages } from "../../lib/content";
import { site, absoluteUrl, breadcrumbSchema } from "../../lib/site";
export function getStaticPaths() {
  const entries = import.meta.glob<
    import("astro").MarkdownInstance<Record<string, never>>
  >("../../articles/*.md", { eager: true });
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, entry: entries[`../../articles/${article.slug}.md`] },
  }));
}
const { article, entry } = Astro.props;
const { Content } = entry;
const service = servicePages.find(
  (item) =>
    item.guide === article.slug ||
    ("additionalGuide" in item && item.additionalGuide === article.slug),
);
const path = `/blog/${article.slug}`;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.excerpt,
  author: { "@type": "Organization", name: site.company, url: site.url },
  mainEntityOfPage: absoluteUrl(path),
  image: absoluteUrl("/og/default.png"),
};
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  path={path}
  type="article"
  schema={[
    articleSchema,
    breadcrumbSchema(
      { name: "Artigos", path: "/blog" },
      { name: article.title, path },
    ),
  ]}
>
  <article class="container">
    <header class="page-heading prose">
      <a class="eyebrow" href="/blog">
        ← Artigos / {article.category}
      </a>
      <h1>{article.title}</h1>
      <p class="lead">{article.excerpt}</p>
      <p class="eyebrow">Por {site.company} · Leitura prática</p>
    </header>
    <div class="prose reading">
      <Content />
      <section>
        <h2>Como podemos ajudar</h2>
        <p>
          {service && (
            <a href={`/servicos/${service.slug}`}>{service.title} ↗</a>
          )}
        </p>
        <a class="btn btn--primary" href="/contato">
          Falar com a equipe ↗
        </a>
      </section>
    </div>
  </article>
</BaseLayout>
