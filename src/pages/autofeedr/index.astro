---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { productBySlug } from "../../lib/site";
const product = productBySlug("autofeedr")!;
---

<BaseLayout
  title={product.name}
  description={`Conheça ${product.name}, um produto de automação de conteúdo.`}
  path="/autofeedr"
>
  <div class="container">
    <header class="page-heading">
      <p class="eyebrow">Produto</p>
      <h1>{product.name}</h1>
      <p class="lead">
        Uma plataforma de automação de conteúdo. Consulte a aplicação para
        conhecer os recursos e condições disponíveis.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={product.appUrl}>
          Acessar a plataforma ↗
        </a>
        <a href="/contato">Falar com a equipe</a>
      </div>
    </header>
  </div>
</BaseLayout>
