---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página não encontrada"
  description="O endereço procurado não foi encontrado."
  noindex={true}
>
  <div class="container section">
    <p class="eyebrow">404</p>
    <h1>
      Esse caminho
      <br />
      não está aqui.
    </h1>
    <p class="lead">
      Você pode voltar ao início ou conversar com nossa equipe.
    </p>
    <a class="btn btn--primary" href="/">
      Voltar ao início ↗
    </a>
  </div>
</BaseLayout>
