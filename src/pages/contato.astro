---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";
const subject = encodeURIComponent("Vamos conversar sobre um projeto");
const prompts = [
  ["O desafio", "O que você quer criar ou melhorar?"],
  ["O contexto", "Como sua equipe trabalha hoje?"],
  ["A prioridade", "Existe um prazo ou resultado em mente?"],
];
---

<BaseLayout
  title="Contato"
  description="Converse com nossa equipe sobre desenvolvimento de software, integrações, automação e inteligência artificial para sua empresa."
  path="/contato"
>
  <div class="container contact-page">
    <header class="contact-heading">
      <p class="eyebrow">Vamos conversar</p>
      <h1>
        Uma ideia.
        <br />
        Um desafio.
        <br />
        <span>Um próximo passo.</span>
      </h1>
      <p class="lead">
        Você não precisa chegar com tudo definido. Conte o que sua empresa
        precisa e começamos por aí.
      </p>
    </header>
    <section class="contact-content" aria-label="Fale com a equipe">
      <div class="contact-main">
        <p class="eyebrow">Fale direto com a equipe</p>
        <a
          class="contact-address"
          href={`mailto:${site.email}?subject=${subject}`}
        >
          {site.email}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="contact-description">
          Envie uma mensagem sobre sua ideia ou operação.
        </p>
        <a
          class="btn btn--primary"
          href={`mailto:${site.email}?subject=${subject}`}
        >
          Iniciar conversa por e-mail <span aria-hidden="true">↗</span>
        </a>
        <p class="contact-note">
          Podemos combinar confidencialidade e acesso antes de analisar
          documentos ou dados da empresa.
        </p>
      </div>
      <div class="contact-preparation">
        <h2>Para começar, basta um pouco de contexto.</h2>
        <ol>
          {prompts.map(([label, description], index) => (
            <li>
              <span class="prompt-number">0{index + 1}</span>
              <div>
                <h3>{label}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .contact-page {
    padding-block: var(--space-20);
  }
  .contact-heading {
    max-width: 850px;
    margin-bottom: var(--space-16);
  }
  .contact-heading h1 {
    font-size: clamp(3.3rem, 6.5vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1.04;
    margin-block: var(--space-6) var(--space-8);
  }
  .contact-heading h1 span {
    color: var(--text-2);
  }
  .contact-heading .lead {
    font-size: var(--text-base);
    max-width: 43ch;
    margin: 0;
  }
  .contact-content {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-20);
    border-top: 1px solid var(--border);
    padding-top: var(--space-12);
  }
  .contact-address {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.8vw, 2.5rem);
    letter-spacing: -0.04em;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact-address span {
    font-size: var(--text-xl);
    flex-shrink: 0;
  }
  .contact-address:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-description {
    color: var(--text-2);
    font-size: var(--text-sm);
    margin-block: var(--space-4) var(--space-8);
  }
  .contact-note {
    font-size: var(--text-xs);
    color: var(--text-2);
    max-width: 48ch;
    margin-top: var(--space-6);
    line-height: 1.8;
  }
  .contact-preparation h2 {
    font-size: var(--text-xl);
    line-height: 1.25;
    max-width: 24ch;
    font-weight: 500;
    margin-bottom: var(--space-8);
  }
  .contact-preparation ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .contact-preparation li {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .prompt-number {
    font: 400 0.65rem var(--font-mono);
    color: var(--text-2);
    padding-top: var(--space-1);
  }
  .contact-preparation h3 {
    font: 500 var(--text-sm) var(--font-sans);
    letter-spacing: 0;
    margin-bottom: var(--space-2);
  }
  .contact-preparation p {
    font-size: var(--text-sm);
    color: var(--text-2);
    margin: 0;
  }
  @media (max-width: 800px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .contact-address {
      font-size: clamp(1.25rem, 4.5vw, 2.5rem);
    }
  }
  @media (max-width: 540px) {
    .contact-page {
      padding-block: var(--space-12);
    }
    .contact-heading h1 {
      font-size: clamp(2.75rem, 10vw, 3.7rem);
    }
    .contact-heading {
      margin-bottom: var(--space-10);
    }
    .contact-content {
      padding-top: var(--space-8);
    }
  }
</style>
