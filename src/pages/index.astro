---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";
import { services, articles } from "../lib/content";
const featured = services.map((service) => articles.find((article) => article.slug === service.guide)!);
---

<BaseLayout title="Desenvolvimento de software e consultoria tecnológica" description={site.description} path="/">
  <section class="container studio-intro">
    <div class="intro-copy">
      <p class="eyebrow">Desenvolvimento de software e consultoria tecnológica</p>
      <h1>Software para o seu jeito de trabalhar.</h1>
      <p class="lead">
        A {site.company} desenvolve sistemas sob medida, integra ferramentas e ajuda
        empresas a escolher e implantar soluções para seus processos.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/contato">Conte seu desafio <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#como-trabalhamos">Veja como trabalhamos <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="studio-plate" aria-hidden="true">
      <div class="plate-field">
        <img src="/brand/eyelid-mark.svg" alt="" width="256" height="256" />
      </div>
    </div>
  </section>

  <section class="container section" id="como-trabalhamos">
    <p class="eyebrow">Como trabalhamos</p>
    <h2>Em que ponto você está?</h2>
    <div class="service-list">
      {services.map((service) => (
        <a class="service-row" href={`/servicos/${service.slug}`}>
          <span class="num" aria-hidden="true">{service.num}</span>
          <h3>{service.title}</h3>
          <p>{service.short}</p>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section studio-method">
    <div class="container split">
      <div>
        <p class="eyebrow">Na prática</p>
        <h2>Começamos por uma rotina real.</h2>
      </div>
      <div>
        <p>Mostre um pedido que passa por três ferramentas, uma aprovação que vive no e-mail ou um relatório que alguém monta toda semana.</p>
        <p>A partir daí, conversamos com quem faz o trabalho, identificamos onde se perde tempo e definimos como testar a primeira mudança.</p>
        <a class="text-link" href="/sobre">Conheça a {site.company} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="container section">
    <p class="eyebrow">Artigos</p>
    <h2>Guias para decidir o próximo passo.</h2>
    <div class="service-list article-index">
      {featured.map((article) => (
        <a href={`/blog/${article.slug}`}>
          <span class="eyebrow">{article.category}</span>
          <h3>{article.title}</h3>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <a class="text-link" href="/blog">Todos os artigos <span aria-hidden="true">↗</span></a>
  </section>

  <section class="container section closing">
    <div class="contact-band">
      <div>
        <h2>O que está tomando tempo da sua equipe?</h2>
        <p>Conte como essa rotina funciona hoje e onde ela trava.</p>
      </div>
      <a class="btn btn--primary" href="/contato">Vamos conversar <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .studio-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(var(--space-8), 5vw, var(--space-20));
    padding-block: var(--space-20);
  }
  .intro-copy h1 {
    max-width: 13ch;
    font-size: clamp(2.75rem, 5.8vw, 5.5rem);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .studio-plate {
    display: grid;
    place-items: center;
    aspect-ratio: 1.16;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-inverse);
    background-image: radial-gradient(ellipse at 50% 42%, var(--accent-strong), transparent 72%);
    padding: var(--space-8);
  }
  .plate-field {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid color-mix(in srgb, var(--text-inverse) 18%, transparent);
    border-radius: var(--radius-sm);
    background-image:
      linear-gradient(90deg, transparent 49.8%, color-mix(in srgb, var(--text-inverse) 12%, transparent) 50%, transparent 50.2%),
      linear-gradient(transparent 49.8%, color-mix(in srgb, var(--text-inverse) 12%, transparent) 50%, transparent 50.2%);
  }
  .plate-field img {
    display: block;
    width: 66%;
    filter: invert(1) drop-shadow(0 var(--space-3) var(--space-5) var(--bg-inverse));
  }
  .studio-method {
    background: var(--bg-inverse);
    color: var(--text-inverse);
  }
  .studio-method .eyebrow { color: var(--border-strong); }
  .studio-method h2 { max-width: 14ch; }
  .studio-method p { max-width: 49ch; }
  .article-index { margin-bottom: var(--space-6); }
  .article-index a {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
  .article-index h3 { margin: 0; }
  .article-index a:hover h3 { text-decoration: underline; text-underline-offset: 0.2em; }
  .closing { padding-top: 0; }
  @media (max-width: 820px) {
    .studio-intro { grid-template-columns: 1fr; padding-block: var(--space-12); }
    .studio-plate { aspect-ratio: 1.65; }
    .plate-field img { width: min(58%, 300px); }
  }
  @media (max-width: 580px) {
    .article-index a { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); }
    .article-index .eyebrow { grid-column: 1 / -1; }
  }
</style>
