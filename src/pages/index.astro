---
import BaseLayout from "../layouts/BaseLayout.astro";
import TunnelScene from "../components/TunnelScene.astro";
import CurvedPanels from "../components/CurvedPanels.astro";
import { site } from "../lib/site";
import { articles } from "../lib/content";
import "../styles/solutions.css";
const offerings = [
  {
    num: "01",
    title: "Software sob medida",
    description:
      "Aplicações, portais e ferramentas pensados para as regras e as pessoas da sua operação.",
    slug: "software-sob-medida",
    type: "software" as const,
  },
  {
    num: "02",
    title: "IA aplicada ao negócio",
    description:
      "Assistentes e fluxos conectados aos seus dados, com contexto, permissões e validação.",
    slug: "inteligencia-artificial",
    type: "ai" as const,
  },
  {
    num: "03",
    title: "Automação e integrações",
    description:
      "Conectamos sistemas, automatizamos rotinas e monitoramos as execuções.",
    slug: "automacao-e-integracoes",
    type: "automation" as const,
  },
];
const steps = [
  [
    "Entender",
    "Conhecemos sua operação e definimos juntos o primeiro problema a resolver.",
  ],
  [
    "Construir",
    "Você acompanha atualizações semanais, testa as entregas e participa das decisões.",
  ],
  [
    "Evoluir",
    "Colocamos a solução em uso e ajustamos a partir da experiência da sua equipe.",
  ],
];
const readingOrder = [
  {
    slug: "consultoria-tecnologica-quando-contratar",
    topic: "Diagnóstico",
    title: "O que uma consultoria tecnológica entrega?",
  },
  {
    slug: "quando-desenvolver-software-sob-medida",
    topic: "Software sob medida",
    title: "Quando faz sentido criar um sistema próprio?",
  },
  {
    slug: "como-descobrir-o-que-automatizar-e-monitorar",
    topic: "Automação",
    title: "O que automatizar e monitorar na empresa?",
  },
  {
    slug: "implementacao-consultoria-ia-empresas",
    topic: "Inteligência artificial",
    title: "Como levar a IA do diagnóstico ao uso real?",
  },
  {
    slug: "como-acompanhar-e-melhorar-processos",
    topic: "Melhoria de processos",
    title: "Como saber se um processo melhorou?",
  },
  {
    slug: "quanto-custa-desenvolver-software-sob-medida",
    topic: "Investimento",
    title: "Quanto custa desenvolver software sob medida?",
  },
];
const featured = readingOrder.map((item) => ({
  ...articles.find((article) => article.slug === item.slug)!,
  ...item,
}));
---

<BaseLayout title={site.homeTitle} description={site.description} path="/">
  <section class="technology-hero" aria-labelledby="hero-title">
    <div class="hero-gridlines" aria-hidden="true"></div>
    <TunnelScene />
    <div class="container hero-copy">
      <h1 id="hero-title">
        Sua próxima ideia.
        <br />
        <span>Em funcionamento.</span>
      </h1>
      <p class="hero-description">
        Software sob medida, automação e inteligência artificial.
        <br class="desktop-break" /> Da descoberta à entrega, com você por
        perto.
      </p>
      <div class="actions hero-actions">
        <a class="btn hero-primary" href="/contato">
          Vamos conversar <span aria-hidden="true">↗</span>
        </a>
        <a class="hero-secondary" href="#solucoes">
          Conheça as soluções <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section
    class="solutions-section"
    id="solucoes"
    aria-labelledby="solutions-title"
  >
    <div class="container solutions-heading">
      <div>
        <p class="eyebrow">O que fazemos</p>
        <h2 id="solutions-title">
          Soluções para
          <br />
          sua operação.
        </h2>
      </div>
      <p class="solutions-intro">{site.presentation}</p>
    </div>
    <div class="container solutions-grid">
      {offerings.map((item) => (
        <a class="solution" href={"/servicos/" + item.slug}>
          <h3>
            {item.title}
            <span aria-hidden="true">↗</span>
          </h3>
          <p>{item.description}</p>
          <span class="solution-details">Saiba mais</span>
        </a>
      ))}
    </div>
    <CurvedPanels />
    <a class="gallery-link" href="/solucoes">
      Conheça nossa experiência ↗
    </a>
  </section>

  <section class="method-section section" id="como-trabalhamos">
    <div class="container">
      <div class="method-heading">
        <div>
          <p class="eyebrow">Como trabalhamos</p>
          <h2>
            Você acompanha
            <br />
            cada etapa.
          </h2>
        </div>
        <p>
          Comece com um diagnóstico independente ou traga uma ideia para
          desenvolvermos juntos.
        </p>
      </div>
      <ol class="method-timeline">
        {steps.map(([title, text], index) => (
          <li>
            <div class="step-marker">
              <span>0{index + 1}</span>
              <i></i>
            </div>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <a class="text-link method-more" href="/sobre">
        Conheça a {site.company} ↗
      </a>
    </div>
  </section>

  <section
    class="container editorial-section section"
    id="artigos"
    aria-labelledby="reading-title"
  >
    <div class="editorial-heading">
      <div>
        <p class="eyebrow">Artigos</p>
        <h2 id="reading-title">Para decidir o próximo passo.</h2>
      </div>
      <a class="text-link" href="/blog">
        Todos os artigos ↗
      </a>
    </div>
    <div class="reading-grid">
      {featured.map((article) => (
        <a class="reading-card" href={"/blog/" + article.slug}>
          <span class="eyebrow">{article.topic}</span>
          <h3>{article.title}</h3>
          <span class="reading-link">
            Ler guia <span aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="closing-section">
    <div class="container">
      <p class="eyebrow">Vamos dar o próximo passo?</p>
      <h2>
        O que sua empresa
        <br />
        pode fazer melhor?
      </h2>
      <div class="closing-bottom">
        <p>
          Conte a ideia, o processo ou o desafio.
          <br />A gente começa entendendo.
        </p>
        <a class="btn hero-primary" href="/contato">
          Converse com a {site.company} <span aria-hidden="true">↗</span>
        </a>
      </div>
      <img
        src="/brand/eyelid-mark.svg"
        alt=""
        width="300"
        height="300"
        aria-hidden="true"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .technology-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: transparent;
    color: var(--text-inverse);
    min-height: clamp(620px, 85svh, 800px);
    display: flex;
    align-items: center;
  }
  .hero-gridlines {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--tech-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--tech-border) 1px, transparent 1px);
    background-size: var(--space-16) var(--space-16);
    opacity: 0.1;
    mask-image: radial-gradient(
      ellipse at center,
      transparent 12%,
      var(--tech-bg) 90%
    );
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-block: var(--space-24);
    pointer-events: none;
  }
  .hero-copy a {
    pointer-events: auto;
  }
  h1 {
    font-size: clamp(3.25rem, 6.3vw, 6.4rem);
    line-height: 1.04;
    letter-spacing: -0.065em;
    font-weight: 500;
    margin: var(--space-6) 0 var(--space-8);
  }
  h1 span {
    color: var(--tech-muted);
  }
  .hero-description {
    font-size: var(--text-base);
    color: var(--tech-muted);
    line-height: 1.8;
  }
  .hero-actions {
    justify-content: center;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }
  .hero-primary {
    background: var(--text-inverse);
    color: var(--tech-bg);
    border-color: var(--text-inverse);
  }
  .hero-primary:hover {
    background: var(--text-inverse);
    color: var(--tech-bg);
    box-shadow: 0 0 var(--space-6)
      color-mix(in srgb, var(--text-inverse) 12%, transparent);
  }
  .hero-secondary {
    font-size: var(--text-sm);
    text-decoration: none;
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .hero-secondary:hover {
    text-decoration: underline;
  }
  .solutions-section {
    padding-block: var(--space-24);
    background: transparent;
    overflow: visible;
  }
  .solutions-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }
  .solutions-heading h2 {
    font-size: clamp(2.25rem, 3.6vw, 3.5rem);
    line-height: 1.12;
  }
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
    perspective: 1600px;
  }
  .solution {
    text-decoration: none;
    min-width: 0;
  }
  .solution h3 {
    font-size: 1.6rem;
    letter-spacing: -0.04em;
  }
  .solution > p {
    color: var(--text-2);
    font-size: var(--text-sm);
    max-width: 34ch;
    line-height: 1.8;
  }
  .method-section {
    background: transparent;
    color: var(--text-inverse);
  }
  .method-section .eyebrow {
    color: var(--tech-muted);
  }
  .method-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-16);
  }
  .method-heading h2 {
    font-size: clamp(2.75rem, 4vw, 4rem);
    font-weight: 500;
  }
  .method-heading > p {
    max-width: 39ch;
    font-size: var(--text-sm);
    color: var(--tech-muted);
  }
  .method-timeline {
    list-style: none;
    margin: var(--space-16) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .step-marker {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    font: 400 var(--text-xs) var(--font-mono);
    color: var(--tech-muted);
  }
  .step-marker i {
    height: 1px;
    flex: 1;
    background: var(--tech-border);
  }
  .method-timeline h3 {
    font-size: var(--text-xl);
    font-weight: 500;
  }
  .method-timeline p {
    font-size: var(--text-xs);
    color: var(--tech-muted);
    line-height: 1.85;
  }
  .editorial-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }
  .editorial-heading h2 {
    font-size: clamp(2.5rem, 3.7vw, 3.5rem);
  }
  .editorial-heading > a {
    margin-bottom: var(--space-6);
  }
  .closing-section {
    background: transparent;
    color: var(--text-inverse);
    padding-block: var(--space-24);
    overflow: hidden;
  }
  .closing-section > .container {
    position: relative;
  }
  .closing-section .eyebrow {
    color: var(--tech-muted);
  }
  .closing-section h2 {
    position: relative;
    z-index: 1;
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.06em;
    margin-block: var(--space-8) var(--space-12);
  }
  .closing-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
  }
  .closing-bottom p {
    font-size: var(--text-sm);
    color: var(--tech-muted);
    margin: 0;
  }
  .closing-section img {
    position: absolute;
    right: var(--space-8);
    top: var(--space-2);
    width: 35%;
    filter: invert(1);
    opacity: 0.09;
    transform: rotate(-12deg);
  }
  @keyframes panel-enter-left {
    from {
      opacity: 0;
      transform: translateX(-30px) rotateY(24deg) rotateZ(-9deg);
    }
    to {
      opacity: 0.75;
      transform: translateX(0) rotateY(24deg) rotateZ(-9deg);
    }
  }
  @keyframes panel-enter-right {
    from {
      opacity: 0;
      transform: translateX(30px) rotateY(-24deg) rotateZ(9deg);
    }
    to {
      opacity: 0.75;
      transform: translateX(0) rotateY(-24deg) rotateZ(9deg);
    }
  }
  @media (min-width: 1600px) {
  }
  @media (max-width: 1100px) {
    .solutions-grid {
      gap: var(--space-5);
    }
    .method-timeline {
      gap: var(--space-6);
    }
  }
  @media (max-width: 800px) {
    .technology-hero {
      min-height: 680px;
    }
    .hero-copy {
      padding-block: var(--space-20);
    }
    .solutions-heading {
      display: block;
      margin-bottom: var(--space-8);
    }
    .solutions-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      max-width: 500px;
    }
    .method-heading {
      display: block;
    }
    .method-heading > p {
      max-width: 50ch;
      margin-top: var(--space-8);
    }
    .method-timeline {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .hero-copy {
      padding-block: var(--space-20);
    }
    h1 {
      font-size: clamp(2rem, 9vw, 2.9rem);
      letter-spacing: -0.065em;
    }
    .hero-description {
      font-size: var(--text-sm);
      max-width: 32ch;
      margin-inline: auto;
    }
    .desktop-break {
      display: none;
    }
    .hero-actions {
      flex-direction: column;
      gap: var(--space-6);
    }
    .technology-hero {
      min-height: 660px;
    }
    .solutions-section {
      padding-block: var(--space-16);
    }
    .solutions-heading h2 {
      font-size: 2.05rem;
    }
    .method-timeline {
      gap: var(--space-8) var(--space-5);
      margin-block: var(--space-10);
    }
    .method-timeline h3 {
      font-size: 1.3rem;
    }
    .method-timeline p {
      font-size: 0.7rem;
    }
    .step-marker {
      margin-bottom: var(--space-5);
    }
    .editorial-heading {
      display: block;
    }
    .editorial-heading h2 {
      font-size: 2.2rem;
    }
    .closing-section {
      padding-block: var(--space-16);
    }
    .closing-section h2 {
      font-size: 2.9rem;
    }
    .closing-bottom {
      flex-direction: column;
      align-items: start;
    }
    .closing-section img {
      width: 70%;
      top: var(--space-12);
      right: calc(-1 * var(--space-12));
    }
  }
  @media (prefers-reduced-motion: reduce) {
  }
  @media (max-width: 800px) {
  }
  .solutions-section {
    padding-bottom: 0;
    background: transparent;
  }
  .solutions-heading {
    margin-bottom: var(--space-8);
  }
  .solutions-intro {
    max-width: 38ch;
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .solutions-grid {
    perspective: none;
    margin-bottom: var(--space-12);
  }
  .solution {
    border-top: 1px solid var(--border-strong);
    padding-top: var(--space-6);
  }
  .solution h3 {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-xl);
  }
  .solution h3 span {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-lg);
  }
  .solution > p {
    margin-bottom: var(--space-4);
  }
  .solution-details {
    font-size: var(--text-xs);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .solution:hover h3 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .method-more {
    color: var(--text-inverse);
  }
  .method-timeline {
    margin-bottom: var(--space-6);
  }
  .editorial-heading h2 {
    max-width: 16ch;
  }
  @media (max-width: 800px) {
    .solutions-grid {
      max-width: none;
      gap: var(--space-6);
    }
    .method-timeline {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .method-timeline li {
      display: grid;
      grid-template-columns: var(--space-8) 1fr;
      gap: var(--space-3) var(--space-4);
    }
    .step-marker {
      grid-row: span 2;
      margin: 0;
      align-self: start;
      padding-top: var(--space-1);
    }
    .step-marker i {
      display: none;
    }
    .method-timeline h3 {
      margin: 0;
    }
    .method-timeline p {
      grid-column: 2;
      margin: 0;
      font-size: var(--text-sm);
    }
  }
  .solutions-section {
    border-top: 1px solid var(--border);
  }
  .method-section > .container {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-16);
  }
  .method-section {
    padding-bottom: 0;
  }
  .closing-section {
    border-top: 1px solid var(--border);
  }
  .closing-section .hero-primary:hover {
    background: var(--text-inverse);
  }
  .reading-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .reading-card {
    display: flex;
    flex-direction: column;
    align-items: start;
    text-decoration: none;
    border-top: 1px solid var(--border-strong);
    padding-block: var(--space-6);
    min-width: 0;
  }
  .reading-card .eyebrow {
    margin-bottom: var(--space-4);
    font-size: 0.65rem;
  }
  .reading-card h3 {
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-6);
    max-width: 25ch;
  }
  .reading-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    font-size: var(--text-xs);
    color: var(--text-2);
  }
  .reading-link > span {
    font-size: var(--text-lg);
  }
  .reading-card:hover h3 {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  @media (max-width: 900px) {
    .reading-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .reading-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .reading-card {
      padding-block: var(--space-5);
    }
    .reading-card h3 {
      max-width: 32ch;
      margin-bottom: var(--space-3);
    }
    .reading-card .eyebrow {
      margin-bottom: var(--space-2);
    }
  }
</style>
