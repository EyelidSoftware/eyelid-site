---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { screens, screenImage } from "../../lib/screens";
import { site, absoluteUrl } from "../../lib/site";
import "../../styles/solutions.css";
const categories = [
  {
    name: "Operações especializadas",
    id: "operacoes-especializadas",
    description:
      "Aplicações para indústria, campo, energia, obras e operações comerciais.",
  },
  {
    name: "Engenharia e operação",
    id: "engenharia-e-operacao",
    description:
      "Desenho técnico, modelos espaciais e ferramentas para operações de engenharia.",
  },
  {
    name: "Software",
    id: "software",
    description:
      "Aplicações que acompanham as regras e as pessoas da sua operação.",
  },
  {
    name: "Automação",
    id: "automacao",
    description:
      "Rotinas, canais e sistemas conectados, com cada etapa visível.",
  },
  {
    name: "Inteligência artificial",
    id: "inteligencia-artificial",
    description: "IA com contexto, fontes e espaço para a participação humana.",
  },
  {
    name: "Gestão e dados",
    id: "gestao-e-dados",
    description:
      "Informação organizada para acompanhar a operação e decidir o próximo passo.",
  },
];
const orderedScreens = categories.flatMap((c) =>
  screens.filter((s) => s.category === c.name),
);
const description = `Conheça a experiência e as competências da ${site.publicName} em desenvolvimento de software, automação, integrações e inteligência artificial aplicada a empresas.`;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Experiência e competências | ${site.publicName}`,
  description,
  url: absoluteUrl("/solucoes"),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: screens.length,
    itemListElement: orderedScreens.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.title,
      url: absoluteUrl(`/solucoes/${s.slug}`),
    })),
  },
};
---

<BaseLayout
  title="Experiência em software, automação e IA"
  description={description}
  schema={schema}
>
  <section class="container screen-intro">
    <p class="eyebrow">Nossa experiência</p>
    <h1>
      Nossa experiência,
      <br />
      aplicada ao seu negócio.
    </h1>
    <p class="screen-lead">
      Desenvolvemos software sob medida, automações e soluções com IA, da
      arquitetura à implantação e evolução em produção. Conheça parte do nosso
      repertório técnico em aplicações, integrações e experiências digitais para
      empresas.
    </p>
    <p class="screen-context">
      Engenharia de software, cuidado com a experiência de uso e participação
      próxima do cliente em cada etapa.
    </p>
    <nav class="screen-categories" aria-label="Tipos de solução">
      {categories.map((c) => (
        <a href={`#${c.id}`}>
          {c.name}{" "}
          <span>{screens.filter((s) => s.category === c.name).length}</span>
        </a>
      ))}
    </nav>
  </section>
  {categories.map((category) => (
    <section
      class="container screen-group"
      id={category.id}
      aria-labelledby={`${category.id}-titulo`}
    >
      <div class="screen-group-title">
        <h2 id={`${category.id}-titulo`}>{category.name}</h2>
        <p>{category.description}</p>
      </div>
      <div class="screen-grid">
        {screens
          .filter((s) => s.category === category.name)
          .map((screen, index) => (
            <article class="screen-card">
              <a href={`/solucoes/${screen.slug}`} class="screen-card-link">
                <div class="screen-card-image">
                  <img
                    src={screenImage(screen.slug, "webp")}
                    alt={screen.imageAlt}
                    width="800"
                    height="550"
                    loading={
                      category.id === "operacoes-especializadas" && index < 2
                        ? "eager"
                        : "lazy"
                    }
                    decoding="async"
                  />
                </div>
                <div class="screen-card-copy">
                  <p class="screen-theme">
                    {screen.theme === "light" ? "Tema claro" : "Tema escuro"}
                  </p>
                  <h3>
                    {screen.title}
                    <span aria-hidden="true">↗</span>
                  </h3>
                  <p>{screen.description}</p>
                  <span class="screen-card-more">
                    Conheça a aplicação <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </article>
          ))}
      </div>
    </section>
  ))}
  <section class="container screen-cta">
    <p class="eyebrow">Experiência e proximidade</p>
    <h2>
      Tecnologia para
      <br />a realidade do seu negócio.
    </h2>
    <p>
      Acompanhamos a operação de perto, traduzimos necessidades em entregas e
      evoluímos as soluções com a participação da sua equipe.
    </p>
    <a class="button" href="/contato">
      Vamos conversar ↗
    </a>
  </section>
</BaseLayout>
