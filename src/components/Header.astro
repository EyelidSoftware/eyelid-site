---
import { site } from "../lib/site";
const links = [
  { href: "/#solucoes", label: "Soluções" },
  { href: "/#como-trabalhamos", label: "Como trabalhamos", compact: "Método" },
  { href: "/solucoes", label: "Em tela" },
  { href: "/blog", label: "Artigos" },
];
---

<header class="site-header">
  <div class="container nav-row">
    <a href="/" aria-label={`${site.company}, início`} class="brand">
      <img
        src="/brand/logo-white.svg"
        alt={site.company}
        width="150"
        height="44"
      />
    </a>
    <nav aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          aria-label={l.label}
          aria-current={
            Astro.url.pathname.startsWith(l.href) ? "page" : undefined
          }
        >
          {"compact" in l ? (
            <>
              <span class="nav-long">{l.label}</span>
              <span class="nav-short" aria-hidden="true">
                {l.compact}
              </span>
            </>
          ) : (
            l.label
          )}
        </a>
      ))}
      <a
        class="nav-contact"
        href="/contato"
        aria-current={Astro.url.pathname === "/contato" ? "page" : undefined}
      >
        Contato <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
<style>
  .nav-short {
    display: none;
  }
  @media (max-width: 540px) {
    .nav-long {
      display: none;
    }
    .nav-short {
      display: inline;
    }
  }
</style>
