---
import { site } from "../lib/site";
const links = [
  { href: "/servicos", label: "O que fazemos" },
  { href: "/sobre", label: "Quem somos" },
  { href: "/blog", label: "Ideias" },
];
---

<header class="site-header">
  <div class="container nav-row">
    <a href="/" aria-label={`${site.company}, início`} class="brand">
      <img src="/brand/logo.svg" alt={site.company} width="150" height="44" />
    </a>
    <nav aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={
            Astro.url.pathname.startsWith(l.href) ? "page" : undefined
          }
        >
          {l.label}
        </a>
      ))}
      <a class="nav-contact" href="/contato">
        Vamos conversar <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
